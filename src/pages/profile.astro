---
import Base from "../layouts/Base.astro";
---
<Base title="誰？">
  <div class="container-header profile-page" style="padding-top: var(--list-top-margin)">
    <div class="bg-white shadow-md rounded-lg p-6">
      <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
        <div class="w-32 h-32 flex items-center justify-center">
          <img src="/icon.ico" alt="icon" width="96" height="96" class="rounded-full" style="object-fit: cover" />
        </div>
        <div>
          <h2 class="text-xl font-semibold mb-2">このサイトについて</h2>
          <p class="text-gray-600 mb-4">
            atepoyo.comは、atepoyoの個人ブログです。<br />
            日常のことについて書いています。
          </p>
          <div class="mb-6">
            <h3 class="font-medium text-gray-700 mb-2">興味のある分野</h3>
            <ul class="list-disc list-inside text-gray-600">
              <li>プログラム</li><li>絵</li><li>服</li><li>漫画</li>
              <li>写真</li><li>音楽</li><li>ゲーム</li>
            </ul>
          </div>
          <div>
            <h3 class="font-medium text-gray-700 mb-2">連絡先</h3>
            <p class="text-gray-600">
              Email: natsuki.photo@gmail.com<br />
              Twitter: <a href="https://twitter.com/atepoyo" target="_blank" rel="noopener noreferrer" class="text-blue-500 underline">@atepoyo</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

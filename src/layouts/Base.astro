---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const { title, description = "atepoyoが気ままに綴るブログ。" } = Astro.props;
const pageTitle = title ? title + " | atepoyo.com" : "atepoyo.com";
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="atepoyo" />
    <link rel="icon" href="/icon.ico" />
    <link rel="alternate" type="application/rss+xml" title="atepoyo.com RSS Feed" href="/rss.xml" />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-grow"><slot /></main>
    <Footer />
  </body>
</html>
